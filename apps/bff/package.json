    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.0",
    "@votoaberto/config": "workspace:*",
    "eslint": "^9.39.5",
    "jest": "^30.0.0",
    "prettier": "^3.9.10",
