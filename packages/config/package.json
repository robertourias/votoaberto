{
  "name": "@votoaberto/config",
  "version": "0.0.0",
  "private": true,
  "description": "Configuração compartilhada: tsconfig, ESLint (flat config) e Prettier",
  "type": "module",
  "prettier": "./prettier/index.mjs",
  "exports": {
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/nestjs.json": "./tsconfig/nestjs.json",
    "./tsconfig/nextjs.json": "./tsconfig/nextjs.json",
    "./eslint/base": "./eslint/base.mjs",
    "./eslint/nestjs": "./eslint/nestjs.mjs",
    "./eslint/nextjs": "./eslint/nextjs.mjs",
    "./prettier": "./prettier/index.mjs",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.71.2"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": ">=5.0.0 <6.1.0",
    "next": ">=16.0.0"
